SECRET_KEY=change-me
PORT=8086
# Daftar akun WA, dipisah koma. Akun pertama = default kalau request tidak kirim `akun`
WA_ACCOUNTS=utama,cs
# Login halaman QR (terpisah dari SECRET_KEY). Kosong / kurang dari 12 karakter = halaman QR terkunci total
ADMIN_USER=admin
ADMIN_PASSWORD=
# Isi 1 HANYA kalau service ini di belakang reverse proxy (nginx/Caddy) yang mengisi X-Forwarded-For.
# Tanpa proxy, biarkan kosong: kalau diisi, penyerang bisa memalsukan IP untuk lolos dari blokir.
TRUST_PROXY=
# Isi 1 untuk tes: 20 pesan masuk terakhir (dari antrian GET /pesan-masuk) tampil di halaman QR.
# Kosongkan lagi setelah selesai tes.
DEBUG_INBOX=

# Docker compose
DB_USER=
DB_PASSWORD=
DB_NAME=
MYSQL_ROOT_PASSWORD=
TUNNEL_TOKEN=
