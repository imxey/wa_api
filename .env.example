SECRET_KEY=change-me
PORT=8086
# Default 127.0.0.1. Isi 0.0.0.0 HANYA kalau dijalankan di dalam container.
HOST=
# Daftar akun WA awal, dipisah koma. HANYA dipakai saat pertama jalan untuk membuat auth/akun.json;
# setelah itu akun dikelola lewat POST/DELETE /akun dan env ini diabaikan.
# Akun pertama = default kalau request tidak kirim `akun`
WA_ACCOUNTS=utama,cs
# Login halaman QR (terpisah dari SECRET_KEY). Kosong / kurang dari 12 karakter = halaman QR terkunci total
ADMIN_USER=admin
ADMIN_PASSWORD=
# Jumlah reverse proxy tepercaya di depan service ini (yang mengisi X-Forwarded-For).
# Contoh: 2 untuk jalur ingress -> Apache -> app. 0/kosong kalau tanpa proxy.
# Jangan lebih besar dari jumlah proxy sebenarnya: penyerang bisa memalsukan IP untuk lolos dari blokir.
TRUST_PROXY=
# Akun yang chat masuknya ditarik (GET /pesan-masuk), dipisah koma. Semua akun tetap bisa kirim.
# Sama seperti WA_ACCOUNTS: hanya untuk migrasi pertama, selanjutnya pakai POST /akun/<akun>/inbox.
# Kosong = tidak ada chat yang ditarik.
INBOX_ACCOUNTS=helpdesk
# Isi 1 untuk tes: 20 pesan masuk terakhir (dari antrian GET /pesan-masuk) tampil di halaman QR.
# Kosongkan lagi setelah selesai tes.
DEBUG_INBOX=

# Docker compose
DB_USER=
DB_PASSWORD=
DB_NAME=
MYSQL_ROOT_PASSWORD=
TUNNEL_TOKEN=
